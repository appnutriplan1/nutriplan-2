# URL del Web App de Google Apps Script (Deploy → Web app → copiar URL).
# Vacía mientras no exista backend real: el frontend cae automáticamente en
# modo mock si VITE_DATA_MODE no está en "remote".
VITE_APPS_SCRIPT_URL=

# 'mock' (por defecto, datos de ejemplo sin backend) | 'remote' (usa VITE_APPS_SCRIPT_URL)
VITE_DATA_MODE=mock

# Solo para el futuro endpoint privado de recetas. NUNCA usar el prefijo
# VITE_ ni importar esta clave desde src/: debe existir únicamente en servidor.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=

# Enlaces para el muro de acceso y los CTA de "Agendar consulta"
VITE_WHATSAPP_LINK=https://wa.me/51999999999
VITE_AGENDA_LINK=https://calendly.com/tu-usuario

# Web Push: generar una sola vez con `npx web-push generate-vapid-keys`.
# Son variables privadas de Vercel; no usar el prefijo VITE_.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@dominio.com
CRON_SECRET=
